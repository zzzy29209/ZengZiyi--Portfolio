<script>
  // Navigation — smooth scroll, no reload
  document.querySelectorAll('.nav-item').forEach(item => {
    item.addEventListener('click', e => {
      e.preventDefault();
      const target = document.querySelector(item.getAttribute('href'));
      if (target) target.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Nav active state on scroll
  const sections = document.querySelectorAll('section');
  const navItems = document.querySelectorAll('.nav-item');
  window.addEventListener('scroll', () => {
    let current = '';
    sections.forEach(s => { if (pageYOffset >= s.offsetTop - 120) current = s.id; });
    navItems.forEach(item => {
      item.classList.toggle('active', item.getAttribute('href') === '#' + current);
    });
  });

  // Education books — click to open
  const eduBooks = document.querySelectorAll('.edu-book');
  eduBooks.forEach(book => {
    book.addEventListener('click', e => {
      e.stopPropagation();
      const wasActive = book.classList.contains('active');
      eduBooks.forEach(b => b.classList.remove('active'));
      if (!wasActive) book.classList.add('active');
    });
  });
  document.addEventListener('click', () => eduBooks.forEach(b => b.classList.remove('active')));

  // Bookmark experience — click to expand
  document.querySelectorAll('.bookmark-item').forEach(item => {
    item.querySelector('.bookmark-tab').addEventListener('click', () => {
      const wasActive = item.classList.contains('active');
      document.querySelectorAll('.bookmark-item').forEach(i => i.classList.remove('active'));
      if (!wasActive) item.classList.add('active');
    });
  });

  // Works tab filter
  const tabs = document.querySelectorAll('.works-tab');
  const cards = document.querySelectorAll('.work-card');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const cat = tab.dataset.cat;
      cards.forEach(card => {
        card.classList.toggle('visible', cat === 'all' || card.dataset.cat === cat);
      });
    });
  });

  // Copy to clipboard
  function copyText(text, el) {
    navigator.clipboard.writeText(text).then(() => {
      const toast = el.querySelector('.copied-toast');
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 1500);
    });
  }
</script>

