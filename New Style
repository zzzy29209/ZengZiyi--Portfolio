<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ZENG ZIYI — Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  :root {
    --cream: #F4EFE2;
    --ink: #1a1a1a;
    --green: #5BA882;
    --green-d: #3F8866;
    --pink: #F0B5BA;
    --orange: #E89249;
    --orange-d: #D67A36;
    --yellow: #F0C84A;
    --red: #E55A4A;
    --red-d: #C84536;
    --navy: #2A3958;
    --navy-d: #1E2B45;
    --purple: #9477B0;
    --serif: 'Cormorant Garamond', serif;
  }
  html, body {
    background: var(--cream);
    color: var(--ink);
    font-family: var(--serif);
  }
  section {
    min-height: 100vh;
    padding: 100px 0 60px;
  }

  /* ===== GLASS NAV ===== */
  .glass-nav {
    position: fixed; top: 0; left: 0; right: 0;
    z-index: 100; display: flex;
    justify-content: center; align-items: center;
    padding: 16px clamp(40px, 6vw, 90px);
    background: rgba(244,239,226,0.72);
    border-bottom: 1px solid rgba(26,26,26,0.10);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    box-shadow: 0 2px 10px rgba(26,26,26,0.04);
    gap: 8px;
  }
  .glass-nav .nav-item {
    padding: 6px 20px; font-weight: 400; font-size: 18px;
    letter-spacing: 1px; color: var(--ink); opacity: 0.55;
    cursor: pointer; transition: opacity 0.2s, font-weight 0.2s;
    text-decoration: none;
  }
  .glass-nav .nav-item:hover { opacity: 0.85; }
  .glass-nav .nav-item.active { opacity: 1; font-weight: 600; }

  /* ===== HERO SECTION ===== */
  #hero { overflow: hidden; padding: 0; }
  .stage { width: 100vw; height: 100vh; position: relative; }
  .top-word {
    position: absolute; top: 110px; left: 50%; transform: translateX(-50%);
    font-weight: 700; font-size: clamp(80px, 12vw, 180px);
    color: var(--ink); letter-spacing: -1px; line-height: 0.95;
    text-align: center; z-index: 5;
  }
  .top-word .by {
    display: block; font-weight: 400; font-size: 16px;
    letter-spacing: 4px; color: var(--green-d); margin-bottom: 8px;
  }
  .hint {
    position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%);
    font-weight: 400; font-size: 16px; color: var(--green-d);
    letter-spacing: 1px; z-index: 5; opacity: 0.85;
  }
  .shelf {
    position: absolute; bottom: 60px; left: 0; right: 0;
    height: 65vh; display: flex; align-items: flex-end;
    justify-content: center; gap: 6px; padding: 0 40px;
  }
  .shelf::after {
    content: ''; position: absolute; bottom: -2px; left: 5%; right: 5%;
    height: 2px; background: rgba(26,26,26,0.08);
  }

  /* ===== DESIGNER BOOK STYLE ===== */
  .book {
    position: relative; border-radius: 4px 4px 2px 2px;
    cursor: pointer; overflow: hidden;
    transition: transform 0.4s cubic-bezier(.4,.0,.2,1), box-shadow 0.4s;
    background-image:
      radial-gradient(ellipse at 20% 50%, rgba(255,255,255,0.15) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 30%, rgba(0,0,0,0.08) 0%, transparent 40%),
      linear-gradient(180deg, rgba(255,255,255,0.06) 0%, transparent 40%, rgba(0,0,0,0.1) 100%);
    box-shadow:
      inset 3px 0 0 rgba(255,255,255,0.2),
      inset -3px 0 0 rgba(0,0,0,0.2),
      inset 0 3px 0 rgba(255,255,255,0.12),
      inset 0 -4px 0 rgba(0,0,0,0.22),
      inset 0 0 12px rgba(0,0,0,0.06),
      0 4px 8px rgba(40,28,15,0.2),
      0 1px 0 rgba(0,0,0,0.15);
  }
  .book::before {
    content: ''; position: absolute; inset: 0;
    background:
      repeating-linear-gradient(90deg, rgba(255,255,255,0.02) 0px, rgba(255,255,255,0.02) 1px, transparent 1px, transparent 3px),
      repeating-linear-gradient(0deg, rgba(0,0,0,0.015) 0px, rgba(0,0,0,0.015) 1px, transparent 1px, transparent 2px),
      url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none; border-radius: 4px;
  }
  .book::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to right,
      rgba(0,0,0,0.22) 0%, rgba(0,0,0,0.05) 4%,
      rgba(255,255,255,0.08) 15%, transparent 40%,
      rgba(0,0,0,0.02) 85%, rgba(0,0,0,0.18) 100%);
    pointer-events: none; border-radius: 4px;
  }
  .book:hover {
    transform: translateY(-16px) rotate(-1.5deg); z-index: 10;
    box-shadow:
      inset 3px 0 0 rgba(255,255,255,0.22),
      inset -3px 0 0 rgba(0,0,0,0.22),
      inset 0 3px 0 rgba(255,255,255,0.14),
      inset 0 -4px 0 rgba(0,0,0,0.24),
      inset 0 0 12px rgba(0,0,0,0.08),
      0 18px 30px rgba(40,28,15,0.22),
      0 3px 0 rgba(0,0,0,0.12);
  }
  .book .pages {
    position: absolute; top: -5px; left: 2px; right: 2px; height: 6px;
    background: linear-gradient(to bottom, #f5eed8 0%, #e8dfc5 40%, #c4b898 100%);
    border-radius: 2px 2px 0 0;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), inset 0 -1px 0 rgba(0,0,0,0.12);
  }
  .book .pages::after {
    content: ''; position: absolute; inset: 1px 2px 0;
    background: repeating-linear-gradient(90deg, rgba(0,0,0,0.08) 0 1px, transparent 1px 2.5px);
    opacity: 0.6;
  }
  .tag {
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, -50%) rotate(-90deg);
    font-weight: 600; font-size: 14px; color: var(--ink);
    white-space: nowrap; letter-spacing: 2px; z-index: 2;
    text-transform: uppercase;
    text-shadow: 0 1px 2px rgba(255,255,255,0.2);
  }
  .stripe {
    position: absolute; left: 8%; right: 8%; height: 2px; z-index: 2; border-radius: 1px;
  }
  .stripe.gold { background: linear-gradient(90deg, #D4A84B, #E8C97A, #D4A84B); height: 2.5px; box-shadow: 0 1px 2px rgba(0,0,0,0.15); }
  .stripe.silver { background: linear-gradient(90deg, #aaa, #ddd, #aaa); height: 1.5px; }
  .logo-dot {
    position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%);
    width: 10px; height: 10px; border: 1.5px solid currentColor;
    border-radius: 50%; z-index: 2; opacity: 0.6;
  }

  /* Hero center book */
  .hero-book {
    position: relative; width: 280px; height: 460px;
    background: linear-gradient(160deg, #3a4f7a 0%, #2A3958 40%, #1E2B45 100%);
    border-radius: 4px 8px 8px 4px;
    box-shadow:
      inset 5px 0 0 rgba(0,0,0,0.3),
      inset -2px 0 0 rgba(255,255,255,0.06),
      inset 0 0 20px rgba(0,0,0,0.15),
      0 16px 30px rgba(20,15,8,0.35),
      0 4px 0 rgba(0,0,0,0.18);
    cursor: pointer; overflow: hidden;
    transition: transform 0.5s cubic-bezier(.4,0,.2,1), box-shadow 0.5s;
    display: flex; flex-direction: column;
    justify-content: space-between; align-items: center;
    padding: 32px 30px 40px; z-index: 6;
  }
  .hero-book::before {
    content: ''; position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(255,255,255,0.06) 0%, transparent 50%),
      url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
    pointer-events: none;
  }
  .hero-book::after {
    content: ''; position: absolute; top: 20px; bottom: 20px; left: 18px;
    width: 1px; background: rgba(255,255,255,0.08);
    box-shadow: 1px 0 0 rgba(0,0,0,0.2); pointer-events: none;
  }
  .hero-book:hover {
    transform: translateY(-20px) rotateZ(-0.8deg);
    box-shadow: inset 5px 0 0 rgba(0,0,0,0.35), 0 28px 44px rgba(20,15,8,0.35);
  }
  .hero-book .top-mark { font-weight: 500; font-size: 13px; letter-spacing: 6px; color: rgba(245,238,222,0.7); text-transform: uppercase; text-align: center; z-index: 2; }
  .hero-book .cover-title { font-weight: 600; font-size: 36px; line-height: 1.05; letter-spacing: 1px; color: #F1E9D3; text-align: center; z-index: 2; }
  .hero-book .cover-title .it { font-weight: 400; color: #E8C97A; display: block; font-size: 22px; margin-top: 10px; }
  .hero-book .cover-foot { font-weight: 400; font-size: 14px; letter-spacing: 4px; color: rgba(245,238,222,0.55); text-align: center; z-index: 2; }
  .hero-book .corner-orn { position: absolute; top: 16px; right: 16px; width: 20px; height: 20px; border: 1px solid rgba(232,201,122,0.4); border-radius: 50%; z-index: 2; }
  .hero-book .corner-orn::after { content: ''; position: absolute; inset: 4px; border: 1px solid rgba(232,201,122,0.3); border-radius: 50%; }

  /* ===== SECTION COMMON ===== */
  .section-header { text-align: center; margin-bottom: 60px; }
  .section-header h2 { font-size: clamp(48px, 8vw, 72px); font-weight: 700; letter-spacing: -2px; margin-bottom: 8px; }
  .section-header .sub { font-size: 18px; color: var(--green-d); font-weight: 400; letter-spacing: 2px; }

  /* ===== ABOUT — BOOKSHELF + PHOTO ===== */
  #about { position: relative; }
  .about-layout {
    max-width: 1200px; margin: 0 auto; padding: 0 40px;
    display: grid; grid-template-columns: 1.5fr 1fr;
    gap: 60px; align-items: center;
  }
  .about-bookshelf {
    position: relative; display: flex;
    align-items: flex-end; justify-content: center;
    gap: 28px; padding-bottom: 18px;
    border-bottom: 3px solid rgba(26,26,26,0.06);
    min-height: 520px;
  }
  .edu-book {
    position: relative; cursor: pointer;
    transition: transform 0.35s cubic-bezier(.4,0,.2,1);
  }
  .edu-book:hover { transform: scale(1.05) translateY(-6px); z-index: 10; }
  .edu-book.active { z-index: 50; }
  .edu-spine {
    position: relative; border-radius: 5px 5px 2px 2px;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 24px 8px;
    background-image:
      radial-gradient(ellipse at 25% 40%, rgba(255,255,255,0.18) 0%, transparent 55%),
      radial-gradient(ellipse at 75% 70%, rgba(0,0,0,0.1) 0%, transparent 45%),
      linear-gradient(180deg, rgba(255,255,255,0.08) 0%, transparent 30%, rgba(0,0,0,0.12) 100%);
    box-shadow:
      inset 3px 0 0 rgba(255,255,255,0.2),
      inset -3px 0 0 rgba(0,0,0,0.22),
      inset 0 3px 0 rgba(255,255,255,0.12),
      inset 0 -4px 0 rgba(0,0,0,0.2),
      inset 0 0 16px rgba(0,0,0,0.06),
      0 6px 12px rgba(40,28,15,0.2),
      0 2px 0 rgba(0,0,0,0.12);
    transition: box-shadow 0.4s;
  }
  .edu-spine::before {
    content: ''; position: absolute; inset: 0; border-radius: 5px;
    background:
      repeating-linear-gradient(90deg, rgba(255,255,255,0.015) 0px, rgba(255,255,255,0.015) 1px, transparent 1px, transparent 3px),
      url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
  }
  .edu-spine::after {
    content: ''; position: absolute; inset: 0; border-radius: 5px;
    background: linear-gradient(to right, rgba(0,0,0,0.2) 0%, transparent 5%, rgba(255,255,255,0.06) 20%, transparent 80%, rgba(0,0,0,0.15) 100%);
    pointer-events: none;
  }
  .edu-spine .pages-top {
    position: absolute; top: -5px; left: 2px; right: 2px; height: 6px;
    background: linear-gradient(to bottom, #f5eed8, #c4b898);
    border-radius: 2px 2px 0 0;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.5);
  }
  .edu-spine .spine-title {
    transform: rotate(-90deg); white-space: nowrap;
    font-weight: 600; font-size: 15px; letter-spacing: 1.5px;
    z-index: 3; text-shadow: 0 1px 2px rgba(255,255,255,0.15);
  }
  .edu-spine .spine-hint {
    position: absolute; bottom: 14px;
    font-size: 10px; font-weight: 400; letter-spacing: 0.5px;
    opacity: 0.7; z-index: 3;
  }
  .edu-spine .spine-gold {
    position: absolute; left: 10%; right: 10%; height: 2px;
    background: linear-gradient(90deg, #D4A84B, #E8C97A, #D4A84B);
    border-radius: 1px; z-index: 3;
    box-shadow: 0 1px 2px rgba(0,0,0,0.12);
  }

  /* Book open panel */
  .edu-panel {
    position: absolute; top: 0; left: 100%;
    width: 340px; height: 100%;
    background: #FDFAF2;
    border: 1px solid rgba(26,26,26,0.06);
    border-left: 4px solid rgba(26,26,26,0.1);
    border-radius: 0 10px 10px 0;
    padding: 28px 24px;
    opacity: 0; pointer-events: none;
    transform: scaleX(0); transform-origin: left center;
    transition: transform 0.45s cubic-bezier(.6,.05,.2,1), opacity 0.3s;
    box-shadow: 8px 4px 20px rgba(40,28,15,0.12);
    overflow-y: auto;
  }
  .edu-book.active .edu-panel { opacity: 1; pointer-events: auto; transform: scaleX(1); }
  .edu-panel .panel-title { font-size: 22px; font-weight: 600; margin-bottom: 4px; }
  .edu-panel .panel-major { font-size: 15px; color: var(--green-d); font-weight: 500; margin-bottom: 4px; }
  .edu-panel .panel-period { font-size: 13px; color: #888; margin-bottom: 14px; }
  .edu-panel .panel-detail { font-size: 14px; line-height: 1.75; color: #444; }
  .edu-panel .panel-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 16px; }
  .edu-panel .panel-tags span { background: rgba(91,168,130,0.12); color: var(--green-d); padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 500; }

  /* Photo */
  .photo-col { display: flex; flex-direction: column; align-items: center; }
  .photo-frame {
    position: relative; padding: 18px;
    border: 2px solid var(--green-d); border-radius: 8px;
    background: var(--cream);
  }
  .photo-frame::before {
    content: ''; position: absolute; inset: -10px;
    border: 1.5px solid var(--green-d);
    border-radius: 20px 6px 20px 6px; pointer-events: none;
  }
  .photo-frame::after {
    content: ''; position: absolute; inset: -18px;
    border: 1px solid var(--green-d);
    border-radius: 40% 10% 40% 10% / 10% 40% 10% 40%;
    pointer-events: none; opacity: 0.5;
  }
  .photo-frame img {
    display: block; width: 280px; height: 360px;
    object-fit: cover; border-radius: 4px;
  }
  .photo-caption { margin-top: 18px; text-align: center; }
  .photo-caption .name { font-size: 20px; font-weight: 600; }
  .photo-caption .role { font-size: 14px; color: var(--green-d); margin-top: 4px; }

  /* ===== EXPERIENCE — BOOKMARK STYLE ===== */
  #experience { background: rgba(255,255,255,0.2); }
  .exp-container { max-width: 1100px; margin: 0 auto; padding: 0 40px; }
  .bookmark-list { display: flex; flex-direction: column; gap: 0; }
  .bookmark-item {
    display: grid; grid-template-columns: 220px 1fr;
    border-bottom: 1px solid rgba(26,26,26,0.06);
  }
  .bookmark-tab {
    position: relative; padding: 20px 20px;
    cursor: pointer; display: flex; flex-direction: column; justify-content: center;
    border-radius: 6px 0 0 6px; transition: all 0.3s;
    border-right: 3px solid transparent;
  }
  .bookmark-tab::before {
    content: ''; position: absolute; left: 0; top: 14px; bottom: 14px;
    width: 5px; border-radius: 0 3px 3px 0; transition: background 0.3s;
  }
  .bookmark-item:nth-child(1) .bookmark-tab::before { background: var(--green); }
  .bookmark-item:nth-child(2) .bookmark-tab::before { background: var(--navy); }
  .bookmark-item:nth-child(3) .bookmark-tab::before { background: var(--orange); }
  .bookmark-item:nth-child(4) .bookmark-tab::before { background: var(--yellow); }
  .bookmark-item:nth-child(5) .bookmark-tab::before { background: var(--red); }
  .bookmark-item:nth-child(6) .bookmark-tab::before { background: var(--purple); }
  .bookmark-tab:hover { background: rgba(255,255,255,0.5); }
  .bookmark-item.active .bookmark-tab { background: rgba(255,255,255,0.7); border-right-color: var(--green-d); }
  .bookmark-tab .bm-company { font-size: 18px; font-weight: 600; }
  .bookmark-tab .bm-period { font-size: 13px; color: #888; margin-top: 2px; }
  .bookmark-content {
    padding: 0; max-height: 0; overflow: hidden;
    transition: max-height 0.5s cubic-bezier(.4,0,.2,1), padding 0.4s;
    background: rgba(255,255,255,0.4); border-radius: 0 8px 8px 0;
  }
  .bookmark-item.active .bookmark-content { max-height: 600px; padding: 24px 28px; }
  .bm-role { font-size: 15px; color: #666; margin-bottom: 12px; }
  .bm-stats { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
  .bm-stat { background: rgba(91,168,130,0.08); border: 1px solid rgba(91,168,130,0.2); border-radius: 6px; padding: 8px 14px; text-align: center; }
  .bm-stat .num { font-size: 20px; font-weight: 700; color: var(--green-d); display: block; }
  .bm-stat .label { font-size: 11px; color: #666; }
  .bm-details { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .bm-details h4 { font-size: 14px; font-weight: 600; margin-bottom: 4px; }
  .bm-details p { font-size: 13px; line-height: 1.7; color: #555; }

  /* ===== WORKS ===== */
  #works { position: relative; }
  .works-container { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
  .works-tabs { display: flex; justify-content: center; gap: 12px; margin-bottom: 40px; flex-wrap: wrap; }
  .works-tab {
    padding: 8px 20px; font-family: var(--serif); font-size: 15px; font-weight: 500;
    border: 1.5px solid rgba(26,26,26,0.15); border-radius: 20px;
    background: transparent; color: var(--ink); cursor: pointer; transition: all 0.25s;
  }
  .works-tab:hover { border-color: var(--green); color: var(--green-d); }
  .works-tab.active { background: var(--green); border-color: var(--green); color: white; }
  .works-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .work-card {
    background: rgba(255,255,255,0.6); border: 1px solid rgba(26,26,26,0.06);
    border-radius: 10px; padding: 22px 20px;
    transition: transform 0.3s, box-shadow 0.3s; display: none;
  }
  .work-card.visible { display: block; }
  .work-card:hover { transform: translateY(-3px); box-shadow: 0 8px 18px rgba(40,28,15,0.08); }
  .work-card .work-type { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1.5px; color: var(--green-d); margin-bottom: 6px; }
  .work-card h3 { font-size: 17px; font-weight: 600; margin-bottom: 6px; }
  .work-card .work-desc { font-size: 13px; line-height: 1.55; color: #555; margin-bottom: 12px; }
  .work-card .work-link { display: inline-block; font-size: 13px; font-weight: 600; color: var(--green-d); text-decoration: none; letter-spacing: 1px; }

  /* ===== CONTACT ===== */
  #contact { min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center; }
  .contact-inner h2 { font-size: clamp(48px, 8vw, 80px); font-weight: 700; letter-spacing: -2px; margin-bottom: 32px; }
  .contact-row { display: flex; gap: 48px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px; }
  .contact-item { text-align: center; cursor: pointer; position: relative; }
  .contact-item .label { font-size: 14px; color: var(--green-d); font-weight: 500; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 6px; }
  .contact-item .value { font-size: 22px; font-weight: 600; color: var(--ink); transition: color 0.2s; }
  .contact-item:hover .value { color: var(--green-d); }
  .contact-item .copy-hint { font-size: 12px; color: #999; margin-top: 4px; }
  .contact-item .copied-toast {
    position: absolute; top: -30px; left: 50%; transform: translateX(-50%);
    background: var(--green-d); color: white; padding: 4px 12px;
    border-radius: 4px; font-size: 12px; opacity: 0;
    transition: opacity 0.3s, top 0.3s; pointer-events: none;
  }
  .contact-item .copied-toast.show { opacity: 1; top: -36px; }
  .contact-cta {
